// Looea - Prisma schema
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BusinessType {
  WOMEN_SALON
  MEN_BARBER
  UNISEX_SALON
  BEAUTY_SALON
  NAIL_SALON
  MAKEUP_STUDIO
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  NEW_REVIEW
  SYSTEM
}

enum Segment {
  MALE
  FEMALE
}

enum BusinessServes {
  MEN
  WOMEN
  UNISEX
}

enum PaymentMethod {
  CASH
  CARD
  UNPAID
}

enum BlockReason {
  LUNCH
  TRAINING
  LEAVE
  EXTERNAL
  CUSTOM
}

// ---------- Core identity ----------

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  avatarUrl           String?
  birthDate           DateTime?
  city                String?
  interests           String? // JSON-encoded string[]
  segment             Segment?
  onboardingCompleted Boolean   @default(false)
  role                Role      @default(CUSTOMER)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business      Business?
  appointments  Appointment[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
}

// ---------- Business ----------

model Business {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name          String
  slug          String         @unique
  type          BusinessType   @default(OTHER)
  serves        BusinessServes @default(UNISEX)
  description   String?
  logoUrl       String?
  coverImageUrl String?
  phone         String?
  email         String?
  instagram     String?
  website       String?

  referralSource    String?
  verified          Boolean   @default(false)
  active            Boolean   @default(true)
  availableNow      Boolean   @default(false)
  availableNowUntil DateTime?
  ratingAvg         Float     @default(0)
  ratingCount       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location          BusinessLocation?
  hours             BusinessHours[]
  staff             BusinessStaff[]
  services          Service[]
  portfolioImages   PortfolioImage[]
  appointments      Appointment[]
  reviews           Review[]
  favorites         Favorite[]
  subscription      Subscription?
  businessCustomers BusinessCustomer[]
  blockedSlots      BlockedSlot[]

  @@index([type])
  @@index([active, verified])
}

model BusinessLocation {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  address    String
  city       String
  district   String  @default("Merkez")
  country    String  @default("Türkiye")
  postalCode String?
  latitude   Float
  longitude  Float

  @@index([city])
  @@index([city, district])
  @@index([latitude, longitude])
}

// dayOfWeek: 0 = Sunday ... 6 = Saturday
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  openTime  String? // "HH:mm"
  closeTime String? // "HH:mm"
  isClosed  Boolean @default(false)

  @@unique([businessId, dayOfWeek])
}

model BusinessStaff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  avatarUrl String?
  title     String? // e.g. "Hair Stylist", "Barber", "Nail Artist"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  schedules    StaffSchedule[]
  timeOff      StaffTimeOff[]
  services     ServiceStaff[]
  appointments Appointment[]
  blockedSlots BlockedSlot[]

  @@index([businessId])
}

// A business-managed customer contact that does not require an app account —
// covers both walk-ins ("geçici müşteri") and customers added directly from
// the business panel. Real registered customers keep booking via User/Appointment.customerId.
model BusinessCustomer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name  String?
  phone String
  email String?

  createdAt DateTime @default(now())

  appointments Appointment[]

  @@unique([businessId, phone])
  @@index([businessId])
}

// A time range closed to bookings (lunch break, training, day off, etc).
// staffId null = blocks the whole business; repeatWeekly matches by dayOfWeek
// indefinitely instead of the single stored date.
model BlockedSlot {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      BusinessStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  date         DateTime
  dayOfWeek    Int
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  reason       BlockReason @default(CUSTOM)
  label        String?
  repeatWeekly Boolean     @default(false)

  createdAt DateTime @default(now())

  @@index([businessId, date])
  @@index([staffId, date])
  @@index([businessId, dayOfWeek])
}

// dayOfWeek: 0 = Sunday ... 6 = Saturday
// A staff member can have multiple shift blocks per day (e.g. 09:00-13:00,
// 14:00-19:00) which naturally represents lunch breaks as the gap between them.
model StaffSchedule {
  id      String        @id @default(cuid())
  staffId String
  staff   BusinessStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  @@index([staffId, dayOfWeek])
}

model StaffTimeOff {
  id      String        @id @default(cuid())
  staffId String
  staff   BusinessStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  reason    String?

  @@index([staffId])
}

// ---------- Categories & services ----------

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String         @unique
  group     String // "SAC" | "GUZELLIK" | "TIRNAK" | "OZEL"
  serves    BusinessServes @default(UNISEX)
  order     Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())

  services        Service[]
  portfolioImages PortfolioImage[]

  @@index([group, order])
}

model Service {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name            String
  description     String?
  durationMinutes Int
  price           Float
  imageUrl        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  staff        ServiceStaff[]
  appointments Appointment[]

  @@index([businessId])
  @@index([categoryId])
}

model ServiceStaff {
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId   String
  staff     BusinessStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
}

model PortfolioImage {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([businessId])
}

// ---------- Booking ----------

model Appointment {
  id                 String            @id @default(cuid())
  businessId         String
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           User?             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessCustomerId String?
  businessCustomer   BusinessCustomer? @relation(fields: [businessCustomerId], references: [id], onDelete: Cascade)
  serviceId          String
  service            Service           @relation(fields: [serviceId], references: [id])
  staffId            String?
  staff              BusinessStaff?    @relation(fields: [staffId], references: [id])

  date      DateTime // day of appointment (midnight UTC)
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  price     Float
  status    AppointmentStatus @default(PENDING)
  notes     String?

  // Shared across the rows of one manually-created multi-service visit so
  // status/payment actions can apply to the whole visit at once. Null for
  // single-service appointments (including all customer-app bookings).
  groupId       String?
  paymentMethod PaymentMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  @@index([businessId, date])
  @@index([staffId, date])
  @@index([customerId])
  @@index([businessCustomerId])
  @@index([groupId])
}

model Review {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  rating     Int
  comment    String?
  photoUrl   String?
  hidden     Boolean @default(false)
  ownerReply String?

  createdAt DateTime @default(now())

  @@index([businessId])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, businessId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ---------- Subscriptions & payments ----------

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  price         Float
  billingPeriod String   @default("MONTHLY") // MONTHLY | YEARLY
  features      String // JSON-encoded string[]
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id         String           @id @default(cuid())
  businessId String           @unique
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])

  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount            Float
  currency          String        @default("EUR")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("stripe")
  providerPaymentId String?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}
