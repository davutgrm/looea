DATABASE_URL="file:./dev.db"
# UYARI: Bu proje Postgres'e geçtikten sonra dev ve prod AYNI Supabase DB'sini
# paylaşıyor. `npx prisma db seed` TÜM tabloları silip demo veriyle değiştirir —
# prisma/seed.ts'deki onay guard'ını atlamadan (SEED_CONFIRM ile) asla otomatik/
# non-interactive çalıştırma.

# Supabase Storage (görsel yükleme — işletme logosu/kapak/portföy, kullanıcı
# profil fotoğrafı). Dashboard > Project Settings > API'den al. Bu proje zaten
# aynı Supabase projesini Postgres için kullanıyor. SERVICE_ROLE_KEY çok
# yetkili bir gizli anahtar — asla NEXT_PUBLIC_ yapma, sadece server action'lar
# içinde kullanılır (bkz. src/lib/supabase-admin.ts). İlk kurulumda bucket'ları
# oluşturmak için: npx tsx scripts/setup-supabase-storage.ts
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

AUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL/AUTH_URL bilerek YOK: next-auth/react bunu build anında client
# bundle'a gömüyor, prod'da yanlış bir değer sızarsa TÜM auth çağrıları o adrese
# gitmeye başlar (bkz. .env'deki not). Auth.js v5 host'u Vercel'de otomatik
# (trustHost, VERCEL env'i üzerinden) her request'ten kendisi çözüyor.

# Google ile giriş (müşteri tarafı). İKİSİ de dolu değilse Google sağlayıcısı ve
# butonu HİÇ görünmez (çalışmayan buton oluşmaz). Google Cloud Console → APIs &
# Services → Credentials → OAuth 2.0 Client ID (Web application) ile oluşturulur.
# Authorized redirect URI: https://<alan-adın>/api/auth/callback/google
# (dev için: http://localhost:3001/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Map provider: "osm" (default, no key needed) | "mapbox" | "google"
NEXT_PUBLIC_MAP_PROVIDER="osm"
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Payment provider (stubbed for now, wire up when going live)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Müşteri / pro (işletme) subdomain ayrımı.
# Dev'de boş bırak: pro dünyası "http://pro.localhost:3001" veya "/pro" ile test edilir.
# Prod'da doldur (örnek):
#   NEXT_PUBLIC_APP_URL="https://kuafi.com"
#   NEXT_PUBLIC_PRO_URL="https://pro.kuafi.com"
#   NEXT_PUBLIC_PRO_HOST="pro.kuafi.com"
#   AUTH_COOKIE_DOMAIN=".kuafi.com"   # subdomain'ler arası oturum paylaşımı için
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_PRO_URL=""
NEXT_PUBLIC_PRO_HOST=""
AUTH_COOKIE_DOMAIN=""
